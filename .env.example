# Copiá este archivo a .env y completá los valores reales (.env nunca se sube al repo).
# En producción (Vercel), estas mismas variables se cargan en
# Project Settings → Environment Variables — no acá.

# API key de Resend (https://resend.com/api-keys), usada por api/contact.ts
# para mandar el formulario de "Vinculación Institucional" por mail.
# Server-side únicamente: sin prefijo VITE_, nunca llega al bundle del cliente.
RESEND_API_KEY=

# Opcional. Mail que recibe los envíos del formulario de contacto.
# Si no se define, api/contact.ts usa mcabrera@adeema.org por default.
CONTACT_TO_EMAIL=
